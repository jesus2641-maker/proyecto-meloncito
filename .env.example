# ==============================================================================
# Beer House — Variables de Entorno (.env.example)
# Copia este archivo como .env en local y reemplaza los placeholders.
# En Render, configura estas mismas variables en el panel "Environment".
# ==============================================================================

# --- Flask & App ---
# Obligatoria en producción (Render). Puedes generarla ejecutando:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria_de_al_menos_32_caracteres
# En local: http://localhost:5000
# En Render: https://tu-app.onrender.com (sin barra final)
BASE_URL=http://localhost:5000

# --- Base de Datos (TiDB Cloud / MySQL con TLS) ---
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu_usuario_tidb.root
DB_PASSWORD=tu_password_tidb
DB_NAME=beerhouse_db
# Opcional: ruta al certificado CA solo si el sistema operativo no incluye los certificados raíz
DB_SSL_CA=

# --- PayPal (Orders v2) ---
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_SECRET=tu_paypal_secret
# 'sandbox' para pruebas o 'live' para producción
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
TASA_COP_USD=4000
PAGO_EXPIRA_MINUTOS=30

# --- Cloudinary (Opcional: imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Brevo (Opcional: correos transaccionales) ---
BREVO_API_KEY=tu_brevo_api_key
BREVO_SENDER_EMAIL=correo@tudominio.com
BREVO_SENDER_NAME=Beer House
