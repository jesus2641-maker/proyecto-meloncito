# Flask Configuration
SECRET_KEY=your_secret_key_here

# Database Configuration
# Opción A: variables sueltas (local / docker compose)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=beerhouse_db
# Opción B: una sola URL (tiene prioridad sobre las anteriores).
# En Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}
# DATABASE_URL=mysql://usuario:clave@host:3306/base

# Producción (Railway): cookies solo por HTTPS
SESSION_COOKIE_SECURE=false
# Crear tablas/seed al arrancar el contenedor (1 = sí)
RUN_DB_INIT=1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# PayPal Configuration (Modo Sandbox / Live)
# Obtén tu Client ID y Secret en developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' para pruebas, 'live' para producción
PAYPAL_MODE=sandbox
# Moneda en la que opera la pasarela (sandbox opera en USD)
PAYPAL_CURRENCY=USD
# Opcional: URL base del API de PayPal (por defecto se resuelve según PAYPAL_MODE)
PAYPAL_API_BASE=
# Minutos durante los cuales se reserva el stock y el pedido para pago antes de expirar
PAGO_EXPIRA_MINUTOS=30

# Pesos colombianos por 1 dólar, por ejemplo 4000
TASA_COP_USD=3305
