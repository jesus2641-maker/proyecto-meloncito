# Flask Configuration
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=beerhouse_db

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# PayPal Configuration (Modo Sandbox / Live)
# Obtén tu Client ID y Secret en developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' para pruebas, 'live' para producción
PAYPAL_MODE=sandbox
# Moneda en la que opera la pasarela (sandbox opera en USD)
PAYPAL_CURRENCY=USD
# Opcional: URL base del API de PayPal (por defecto se resuelve según PAYPAL_MODE)
PAYPAL_API_BASE=
# Minutos durante los cuales se reserva el stock y el pedido para pago antes de expirar
PAGO_EXPIRA_MINUTOS=30
